datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Les Services (YouTube Premium, Disney+, etc.)
model Service {
  id          String         @id // ex: "youtube", "disney"
  name        String
  tagline     String
  price       Float          // Prix de vente conseillé
  original    Float          // Prix public France
  maxSlots    Int
  active      Boolean        @default(true)
  icon        String         // ex: "▶", "✦"
  gradient    String         // Dégradé CSS de fond
  features    String[]       // Liste des avantages
  stocks      StockAccount[]
  orders      Order[]
}

// 2. Les comptes de stock achetés à l'étranger (B2C)
model StockAccount {
  id                   String   @id @default(uuid())
  serviceId            String
  service              Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  accountsBoughtPrice  Float    @default(0.00) // COGS (Coût de revient)
  price                Float    // Prix mensuel loué
  maxSlots             Int
  filledSlots          Int      @default(0)
  details              String   // Identifiants cryptés ou liens d'invitation
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  orders               Order[]
}

// 3. Commandes / Abonnements loués par les clients
model Order {
  id             String       @id @default(cuid())
  date           DateTime     @default(now())
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id])
  stockAccountId String
  stockAccount   StockAccount @relation(fields: [stockAccountId], references: [id])
  price          Float
  fee            Float        @default(0.00)
  total          Float
  details        String       // Copie des identifiants au moment de l'achat
  clientEmail    String
  youtubeEmail   String?      // Email Google/YouTube du client (pour invitation famille YouTube Premium)
  paymentMethod  String?      // "Carte bancaire (Stripe)", "PayPal", "Cryptomonnaie"
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id])
  status                   String       @default("active") // "pending", "active", "cancelled", "cancelled_pending", "unpaid"
  cancellationRequestedAt  DateTime?
  cancellationEffectiveAt  DateTime?
  unpaidSince              DateTime?
  reminderCount            Int          @default(0)
  lastReminderAt           DateTime?
  // Stripe Subscriptions
  stripeSubscriptionId String?  @unique
  stripeCustomerId     String?
  cardLast4            String?
  cardBrand            String?
  cardExpMonth         Int?
  cardExpYear          Int?
  nextBillingAt        DateTime?
  // Preuve d'acceptation des conditions de vente (checkout)
  acceptedCgv                Boolean   @default(false)
  acceptedImmediateExecution Boolean   @default(false)
  acceptedAt                 DateTime?
  acceptedTermsAt            DateTime?
  acceptedWithdrawalWaiverAt DateTime?
  acceptedEligibilityAt      DateTime?
  termsVersion               String?
  acceptanceUserAgent        String?
  acceptanceIp               String?
  chats          ChatThread?
  invoice        Invoice?
}

// 5. Factures émises (facturation micro-entreprise)
model Invoice {
  id            String   @id @default(cuid())
  number        String   @unique // ex: SM-2026-0001
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  issuedAt      DateTime @default(now())
  paidAt        DateTime
  clientEmail   String
  clientName    String?
  clientAddress String?
  serviceName   String
  description   String
  durationLabel String   @default("1 mois")
  quantity      Int      @default(1)
  unitPriceHT   Float
  totalHT       Float
  vatAmount     Float    @default(0)
  totalTTC      Float
  paymentMethod String   // "Carte bancaire (Stripe)" | "PayPal"
  status        String   @default("Payée")
  createdAt     DateTime @default(now())
}

// Compteurs séquentiels (numérotation continue des factures)
model Counter {
  id    String @id // ex: "invoice-2026"
  value Int    @default(0)
}

// 3-bis. Comptes clients (auth email/mot de passe)
model Customer {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  emailVerified        Boolean   @default(false)
  verificationToken    String?
  resetToken           String?
  resetTokenExp        DateTime?
  pendingEmail         String?   // Nouvelle adresse en attente de confirmation
  emailChangeToken     String?
  emailChangeTokenExp  DateTime?
  sessionVersion       Int       @default(0)
  loginAttempts        Int       @default(0)
  lockedUntil          DateTime?
  stripeCustomerId     String?   @unique
  createdAt            DateTime  @default(now())
  orders               Order[]
}

// 4. Fils de discussion Support
model ChatThread {
  id        String    @id
  orderId   String    @unique
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title     String
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id        String     @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    String     // "Vous" ou "Support StreamMalin"
  text      String
  createdAt DateTime   @default(now())
}

// 6. Paramètres globaux de la plateforme (crypto adresses, gateways, commissions)
model Setting {
  key   String @id
  value String
}

// 7. Évènements webhook Stripe déjà traités — garantit l'idempotence
//    (un évènement rejoué par Stripe ne crée pas de commande en double).
model ProcessedWebhookEvent {
  id        String   @id // event.id fourni par Stripe
  type      String
  createdAt DateTime @default(now())
}

// 8. Compteurs de limitation de débit (anti brute-force / anti-spam).
model RateLimit {
  key       String   @id // ex: "login:1.2.3.4"
  count     Int      @default(0)
  windowEnd DateTime
}

// 9. Journal d'audit des actions administrateur.
model AuditLog {
  id          String   @id @default(cuid())
  action      String   // ex: "order.validate", "service.delete"
  entityType  String   // "order" | "service" | "stock" | "settings"
  entityId    String?
  description String
  ip          String?
  createdAt   DateTime @default(now())
}
