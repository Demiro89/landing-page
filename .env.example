# -----------------------------------------------------------------------------
# CONFIGURATION STREAMMALIN - ENVIRONNEMENT LOCAL
# -----------------------------------------------------------------------------

# 1. Base de données PostgreSQL (Prisma ORM)
# Remplacez par votre chaîne de connexion Supabase, Neon ou PostgreSQL local
DATABASE_URL="postgresql://postgres:streammalin_secure_pass@localhost:5432/streammalin?schema=public"
DIRECT_URL="postgresql://postgres:streammalin_secure_pass@localhost:5432/streammalin?schema=public"

# 2. Sécurité Administrateur — OBLIGATOIRE, aucune valeur par défaut.
# Mot de passe pour déverrouiller le dashboard admin (/admin) — 8 caractères minimum.
ADMIN_PASSWORD="CHANGEZ_MOI_mot_de_passe_admin_fort"
# Token secret httpOnly sécurisant les APIs admin — 16 caractères minimum.
# Générez une valeur aléatoire : openssl rand -hex 24
ADMIN_SECRET_TOKEN="CHANGEZ_MOI_token_admin_aleatoire"
# Secret de signature des sessions client — 16 caractères minimum, OBLIGATOIRE.
# Générez une valeur aléatoire : openssl rand -hex 32
CLIENT_SESSION_SECRET="CHANGEZ_MOI_secret_session_aleatoire"
# Clé de chiffrement des identifiants au repos (AES-256) — 32 caractères minimum.
# Générez une valeur aléatoire : openssl rand -hex 32
# ATTENTION : ne changez jamais cette clé une fois des données chiffrées en base.
ENCRYPTION_KEY="CHANGEZ_MOI_cle_de_chiffrement_aleatoire"

# 3. Passerelle de Paiement CB (Stripe)
# Utilisez les clés Stripe de test en développement, jamais celles de production.
STRIPE_SECRET_KEY="sk_test_mock"
STRIPE_WEBHOOK_SECRET="whsec_mock"
STRIPE_SIMULATION_ENABLED="false"

# 4. Emails transactionnels (Resend). Domaine expéditeur à vérifier chez Resend.
# Sans configuration, aucun identifiant ni lien privé n'est affiché dans les logs.
RESEND_API_KEY=""
# L'expéditeur actuel est StreamMalin <noreply@streammalin.fr> (lib/nodemailer.ts).

# 5. URL de l'Application
# Requis pour les redirections Stripe de retour
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 6. Porte d'accès au site (mode « accès restreint / coming soon »)
# Si défini, le site entier exige ce code avant toute navigation (page /acces).
# Laissez vide ou supprimez la ligne pour ouvrir le site à tous.
# Le code est partagé (un seul code pour tous les visiteurs autorisés).
SITE_ACCESS_CODE=""

# 7. Nettoyage planifié. Générer un secret aléatoire, jamais une valeur publique.
CRON_SECRET="CHANGEZ_MOI_secret_cron_aleatoire"

# 8. Hors Vercel, activer UNIQUEMENT derrière un proxy qui remplace les en-têtes IP
# et interdit les connexions directes. Sinon tous les clients partagent "unknown".
TRUSTED_PROXY_HEADERS="false"
